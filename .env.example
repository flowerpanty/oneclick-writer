# 1) Copy this file to .env
# 2) Fill only the values you need

# Optional: Naver Search API credentials for /research
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here

# Optional: separate Naver DataLab credentials for trend board
NAVER_DATALAB_CLIENT_ID=your_naver_datalab_client_id_here
NAVER_DATALAB_CLIENT_SECRET=your_naver_datalab_client_secret_here

# Optional: Naver Search Ad keyword tool credentials for related keywords
NAVER_SEARCHAD_CUSTOMER_ID=your_naver_searchad_customer_id_here
NAVER_SEARCHAD_ACCESS_LICENSE=your_naver_searchad_access_license_here
NAVER_SEARCHAD_SECRET_KEY=your_naver_searchad_secret_key_here

# Set to true for cloud deployment (Render/Railway/etc.) to disable browser automation
DISABLE_BROWSER_AUTOMATION=false

# Legacy / optional OpenAI vars
OPENAI_API_KEY=your_api_key_here

# Optional
OPENAI_MODEL=gpt-5.2
PORT=8787
